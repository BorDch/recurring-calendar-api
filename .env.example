# Export these variables with your process manager or: set -a; source .env; set +a
CALENDAR_PROFILE=production
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=calendar.example.com
CSRF_TRUSTED_ORIGINS=https://calendar.example.com
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Set only behind a trusted proxy that removes incoming X-Forwarded-Proto.
CALENDAR_TRUST_PROXY_HTTPS=1
# CALENDAR_HTTPS_ENABLED defaults to 1; set 0 only for a local HTTP smoke test.
